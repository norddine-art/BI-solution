                        <connection
                          refId="Package\INI _SYN_SECTEUR\FAMILLE\Tâche de flux de données\CDC Source.Connections[Connection]"
                          connectionManagerID="{F4B4C383-C2FB-43E1-A55D-E2DE2F684E28}:external"
