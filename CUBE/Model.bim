            "sourceColumn": "TOTAL_VENDU",
            "sourceProviderType": "Integer"
          },
          {
            "name": "TOTAL_INVENDU_POINTE",
            "dataType": "int64",
            "sourceColumn": "TOTAL_INVENDU_POINTE",
            "sourceProviderType": "Integer"
          },
          {
            "name": "TOTAL_RENDUS_COM",
            "dataType": "int64",
            "sourceColumn": "TOTAL_RENDUS_COM",
            "sourceProviderType": "Integer"
          },
          {
            "name": "TOTAL_RENDUS_US",
            "dataType": "int64",
            "sourceColumn": "TOTAL_RENDUS_US",
            "sourceProviderType": "Integer"
          },
          {
            "name": "PRIX_VNT",
            "dataType": "double",
            "sourceColumn": "PRIX_VNT",
            "sourceProviderType": "Double"
          },
          {
            "type": "calculated",
            "name": "Prix global",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": " [TOTAL_VENDU] * [PRIX_VNT]"
          },
          {
            "type": "calculated",
            "name": "Ajouter une colonne2",
            "dataType": "int64",
            "isDataTypeInferred": true
          }
        ],
        "partitions": [
          {
            "name": "FACT_SALES",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " SELECT [dbo].[FACT_SALES].* FROM [dbo].[FACT_SALES] ",
              "dataSource": "SqlServer DESKTOP-IC9SR86DATAWAREHOUSE DTWH"
            }
          }
        ],
        "measures": [
          {
            "name": "Quantité Total",
            "expression": " (SUM(FACT_SALES[TOTAL_VENDU]) * SUM(DIM_ARTICLE[POIDS])) / 1000000"
          },
          {
            "name": "Quantité Total Invendue",
            "expression": "( SUM(FACT_SALES[TOTAL_INVENDU_POINTE]) * SUM(DIM_ARTICLE[POIDS]))/1000000"
          },
          {
            "name": "Perte",
            "expression": "(( SUM(FACT_SALES[TOTAL_RENDUS_COM])+SUM(FACT_SALES[TOTAL_RENDUS_US])) * SUM(DIM_ARTICLE[POIDS])) /1000000"
          },
          {
            "name": "Evo Qty T A vs A-1 %",
            "expression": [
              " ",
              "VAR Current_Value = [Quantité Total]",
              "VAR Last_Value = ",
              "    CALCULATE(",
              "        [Quantité Total],",
              "        SAMEPERIODLASTYEAR(DIM_DATE[PK_Date])",
              "    )",
              "RETURN ",
              "    DIVIDE(",
              "        (Current_Value - Last_Value),",
              "        Last_Value,",
              "        0  -- Retourne 0 si division par zéro",
              "    )"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Evo Qty T M vs M-1 %",
            "expression": [
              "",
              "VAR Current_Value = [Quantité Total]",
              "VAR Last_Value =",
              "    CALCULATE(",
              "        [Quantité Total],",
              "        DATEADD(DIM_DATE[Mois_Fiscal],-1,MONTH)",
              "    )",
              "RETURN",
              "    DIVIDE(",
              "        (Current_Value - Last_Value),",
              "        Last_Value,",
              "        0  -- Retourne 0 si division par zéro",
              "    )"
            ]
          },
          {
            "name": "taux invendu",
            "expression": "([Quantité Total Invendue]/[Quantité Total])",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "taux perte",
            "expression": "([Perte]/[Quantité Total])",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "CA",
            "expression": " SUM(FACT_SALES[Prix global])"
          },
          {
            "name": "prix de vente en kg",
            "expression": " DIVIDE([Quntité Kg], [Prix Vente Global],0)"
          },
          {
            "name": "Quntité Kg",
            "expression": " Divide(SUM(FACT_SALES[TOTAL_VENDU]) * SUM(DIM_ARTICLE[POIDS]), 1000,0)"
          },
          {
            "name": "Prix Vente Global",
            "expression": " Sum(FACT_SALES[PRIX_VNT])"
          }
        ],
